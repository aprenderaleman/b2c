{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/cron/class-reminders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/trial-reminders-24h",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/trial-reminders-morning",
      "schedule": "0 6,7 * * *"
    },
    {
      "path": "/api/cron/trial-reminders-30m",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/comunicados-dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/recordings-reconcile",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/diagnostico-followups",
      "schedule": "*/30 * * * *"
    }
  ]
}
