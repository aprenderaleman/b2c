# Environment — NEVER commit secrets.
.env
.env.*
!.env.example
web/.env.local
web/.env.production

# SSH keys + tokens from deployment helpers
known_hosts
*.pem
*.key
deploy_tokens.txt
.cron-secret.local

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# Node
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local dev (Claude Code launch.json + settings.local.json varían por máquina).
# Patrón con ** + negaciones porque `.claude/` solo ignora el contenido
# si el directorio NO está excluido como un todo; con /** las negaciones
# de los skills funcionan.
.claude/**
!.claude/skills/
!.claude/skills/**

# WhatsApp pairing QR (locally-generated, stale after ~30s)
web/public/qr-local.png

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# WhatsApp sessions (Evolution API)
whatsapp/instances/
whatsapp/sessions/
whatsapp/tokens/

# Local Supabase
supabase/.branches
supabase/.temp

# Credentials
credentials/
*.pem
*.key

# Materiales didácticos generados (binarios pesados — regenerables con scripts/materiales/generate.mjs)
/materiales/
